# Copy outside the repository or to an ignored local file; edit existing container paths.
# Commands run INSIDE the previously verified container.
export WORKSPACE=/workspace
export ASCEND_REPO="$WORKSPACE/vllm-ascend"
# Parent directory containing kt_kernel/, NOT the CMake build directory.
export KT_BUILD="$WORKSPACE/cpu_moe/kt-native-profile-package"
export MODEL_PATH=/models/DeepSeek-V4-Flash-0731
export GGUF_PATH='/models/gguf/dsv4_layer{layer_idx}_mxfp4.gguf'
export LOG_ROOT=/workspace/logs/cpu_moe
# Hardware defaults follow the verified 153 configuration; inspect topology before changing host.
export NPU=4 PORT=8144 BS=1 DSPARK=7 PREFETCH=0
export NUMA_NODE=1 HOST_WEIGHT_NUMA_NODE=0 CPU_THREADS=30
export POLL_CPU=62 COMPLETION_CPU=63 DMA_CPU=127
